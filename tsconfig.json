{
  "compilerOptions": {
    // 成果物の出力先を dist フォルダに指定
    "outDir": "./dist",

    // モジュールとターゲットの設定（最新のNode.js向け）
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],

    // その他の出力設定
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // 型チェックを厳格にする設定
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // モジュールの推奨設定
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}